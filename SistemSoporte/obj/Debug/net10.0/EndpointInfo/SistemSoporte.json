  "paths": {
    "/min/tickets/resumen": {
      "get": {
        "tags": [
          "SistemSoporte"
        ],
        "summary": "Resumen agregado: total, por estado y por prioridad",
        "operationId": "ResumenTickets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/min/tickets/{id}/reabrir": {
      "post": {
        "tags": [
          "SistemSoporte"
        ],
        "summary": "Reabre un ticket en estado Resuelto pasándolo a EnProceso",
        "operationId": "ReabrirTicket",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
