            "format": "int32"
          },
          "codigo": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "prioridad": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "clienteId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
